# ---------------------------------------------------------------
# Mijmara — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, hreflang). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mijmara.netlify.app

# --- Supabase (optional: enables accounts, votes, reviews, edits, moderation) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by `npm run import:supabase` and never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# "bundled" (default) reads the CSV-compiled dataset; "supabase" reads approved content from the database.
CONTENT_SOURCE=bundled

# --- Matcher (optional: without a key the rule-based matcher is used) ---
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
MATCHER_MODEL=claude-opus-5-5
