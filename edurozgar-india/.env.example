NEXT_PUBLIC_SUPABASE_URL=https://qilvkchratzbbrdvzkkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4tMHiGMPPDpGkUJaDtcc7g_jRiDiw3O

# The real public domain the site is deployed at. Used for canonical URLs,
# sitemap.xml, robots.txt, and Open Graph tags — leave blank only for local dev.
NEXT_PUBLIC_SITE_URL=

# Optional. Set to a real Google Analytics measurement ID (e.g. G-XXXXXXX) to
# enable analytics — it still only loads for visitors who accept analytics
# cookies in the consent banner. Leave blank to keep analytics off entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Set to a real Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXX)
# to enable ads — it still only loads for visitors who accept advertising
# cookies in the consent banner. Leave blank to keep ads off entirely.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Server-only. Get from Supabase dashboard: Project Settings -> API -> service_role key.
# Required for src/app/api/admin/* routes (review queue, audit log). Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Any random string; the admin panel sends it as a header to authorize
# admin API calls. This is a stopgap, not real authentication — see README.
ADMIN_API_TOKEN=
