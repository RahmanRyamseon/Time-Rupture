# Copy to .env.local for development, or set in Vercel project settings.
# Never commit the real .env.local — it's already gitignored.

# GitHub REST API token used by the admin upload tool to commit new meme
# entries. Fine-grained PAT scoped to this repo only, "Contents: read and
# write" permission.
GITHUB_TOKEN=

# Branch the admin upload tool commits to. Defaults to "master" if unset.
ADMIN_GITHUB_BRANCH=

# Hex SHA-256 digest of the admin password — NOT the raw password itself.
# Generate with:
#   printf '%s' 'your-password-here' | shasum -a 256
ADMIN_UPLOAD_PASSWORD_HASH=

# Any long random string, used to sign the admin session cookie. Generate
# with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
