# Copy to .env and change every value marked CHANGE-ME. Never commit .env.

# --- Branding (single place to rename the product) ---
APP_NAME=Earthworks Monitor

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_DB=earthworks
POSTGRES_USER=earthworks
POSTGRES_PASSWORD=CHANGE-ME-db-password
# Used by api and worker. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://earthworks:CHANGE-ME-db-password@db:5432/earthworks

# --- Redis (job queue, login rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-long-random-string
ACCESS_TOKEN_TTL_MINUTES=480
# true when served over HTTPS (production). false only for local http://localhost.
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Storage ---
DATA_DIR=/data
MAX_UPLOAD_MB=50
MAX_DEM_UPLOAD_MB=4096

# --- Volume analytics (explained in METHOD.md) ---
# Height changes smaller than this many sigmas are not counted as cut or fill.
LOD_SIGMA_MULTIPLIER=1.96
# Width of the reported +/- ranges in sigmas (1.96 = 95 % confidence).
CONFIDENCE_Z=1.96
# Assumed correlation length of elevation errors, in pixels.
UNCERTAINTY_CORRELATION_PIXELS=20
# Ground closer than this to a work zone is not used as stable ground (metres).
STABLE_ZONE_BUFFER_M=10
MIN_STABLE_PIXELS=1000
# Surveys are cropped to the site boundary plus this margin (metres).
SITE_BUFFER_M=150

# --- Photogrammetry engine (used by the worker) ---
PHOTOGRAMMETRY_ENGINE=asp
# 0 = let ASP use every core.
ASP_THREADS=0
ASP_PROCESSES=0
STEREO_ALGORITHM=asp_mgm
STEREO_SUBPIXEL_MODE=9
MAX_STEREO_UPLOAD_MB=8192
# Keep intermediate stereo files after a job (large; for debugging only).
KEEP_ENGINE_WORKDIR=false

# --- Alignment to the baseline survey ---
# vertical_shift: remove the median height difference on stable ground.
# pc_align: 3-D co-registration with ASP first, then the same vertical check.
ALIGNMENT_METHOD_UPLOAD=vertical_shift
ALIGNMENT_METHOD_STEREO=pc_align
# nuth (Nuth & Kaab DEM co-registration) or point-to-plane (ICP).
PC_ALIGN_METHOD=nuth
PC_ALIGN_TRANSLATION_ONLY=true
# 0 = derive the search distance from the data.
PC_ALIGN_MAX_DISPLACEMENT_M=0
# Convert between WGS84-ellipsoid and EGM96/EGM2008 heights when a surface's height
# reference differs from the site's (uses the geoid grids bundled with ASP).
GEOID_CONVERSION=true
# Surfaces coarser than this are labelled "demonstration resolution".
DEMO_RESOLUTION_THRESHOLD_M=10

# --- Jobs ---
JOB_TIMEOUT_SECONDS=21600

# --- Web ---
WEB_PORT=8080
# Optional raster basemap (the only external service). Leave empty for no basemap
# (fully self-contained / data-residency mode).
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Demo seed (idempotent). Set SEED_DEMO_ON_START=false in production. ---
SEED_DEMO_ON_START=true
DEMO_ANALYST_EMAIL=analyst@example.com
DEMO_ANALYST_PASSWORD=CHANGE-ME-analyst-password
DEMO_VIEWER_EMAIL=viewer@example.com
DEMO_VIEWER_PASSWORD=CHANGE-ME-viewer-password
