# Copy to .env and change every value marked CHANGE-ME. Never commit .env.

# --- Branding (single place to rename the product) ---
APP_NAME=Earthworks Monitor

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_DB=earthworks
POSTGRES_USER=earthworks
POSTGRES_PASSWORD=CHANGE-ME-db-password
# Used by api and worker. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://earthworks:CHANGE-ME-db-password@db:5432/earthworks

# --- Redis (job queue, login rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-long-random-string
ACCESS_TOKEN_TTL_MINUTES=480
# true when served over HTTPS (production). false only for local http://localhost.
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Storage ---
DATA_DIR=/data
MAX_UPLOAD_MB=50

# --- Web ---
WEB_PORT=8080
# Optional raster basemap (the only external service). Leave empty for no basemap
# (fully self-contained / data-residency mode).
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Demo seed (idempotent). Set SEED_DEMO_ON_START=false in production. ---
SEED_DEMO_ON_START=true
DEMO_ANALYST_EMAIL=analyst@example.com
DEMO_ANALYST_PASSWORD=CHANGE-ME-analyst-password
DEMO_VIEWER_EMAIL=viewer@example.com
DEMO_VIEWER_PASSWORD=CHANGE-ME-viewer-password
