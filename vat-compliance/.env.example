# Copy to .env.local for development, or set in Vercel project settings.
# Never commit the real .env.local — it's already gitignored.

# Supabase project URL and publishable (anon) key. Safe to expose to the
# browser by design — access control is enforced entirely by Postgres Row
# Level Security policies (see supabase/migrations/0001_init.sql), never by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by src/app/api/classify/route.ts to run the Rate-vs-Nature
# AI classification. Never reference this with a NEXT_PUBLIC_ prefix and never
# import it into a Client Component — it must only ever be read inside a
# Route Handler / Server Component.
ANTHROPIC_API_KEY=
