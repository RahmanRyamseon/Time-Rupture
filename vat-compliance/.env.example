# Copy to .env.local for development, or set in Vercel project settings.
# Never commit the real .env.local — it's already gitignored.

# Supabase project URL and publishable (anon) key. Safe to expose to the
# browser by design — access control is enforced entirely by Postgres Row
# Level Security policies (see supabase/migrations/0001_init.sql), never by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by src/app/api/classify/route.ts for the Rate-vs-Nature
# AI classification pass. Set ONE of these — the app auto-selects whichever
# is present, preferring the free/cheapest option first:
#   1. GEMINI_API_KEY   — Google AI Studio has a genuinely free tier. Get one
#                          at https://aistudio.google.com/apikey. Recommended.
#   2. DEEPSEEK_API_KEY — very low per-token cost. https://platform.deepseek.com
#   3. ANTHROPIC_API_KEY — no free tier, used if neither of the above is set.
#
# (GitHub Copilot isn't an option here — Copilot has no public API for
# server-side completions from a third-party app like this one.)
#
# Never reference any of these with a NEXT_PUBLIC_ prefix and never import
# them into a Client Component — they must only ever be read inside a Route
# Handler / Server Component.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a specific provider instead of auto-selecting by which key
# is set above. One of: gemini | deepseek | anthropic
AI_PROVIDER=
