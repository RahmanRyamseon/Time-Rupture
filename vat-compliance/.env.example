# Copy to .env.local for development, or set in Vercel project settings.
# Never commit the real .env.local — it's already gitignored.

# There is no account system and no server-side database. Everything a
# user uploads (AP/AR lines, capital assets, filed return boxes, AI
# classification results) is kept only in that browser's localStorage —
# see src/lib/workpaper/context.tsx. Nothing here configures a backend
# for workpaper data; the only external calls this app makes are to the
# AI provider below (for the Rate-vs-Nature classification pass) and,
# if configured, Google AdSense.

# Used for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# Defaults to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://bahrainvat.vercel.app

# Server-only. Used by src/app/api/classify/route.ts for the Rate-vs-Nature
# AI classification pass. Set ONE of these — the app auto-selects whichever
# is present, preferring the free/cheapest option first:
#   1. GEMINI_API_KEY   — Google AI Studio has a genuinely free tier. Get one
#                          at https://aistudio.google.com/apikey. Recommended.
#   2. DEEPSEEK_API_KEY — very low per-token cost. https://platform.deepseek.com
#   3. ANTHROPIC_API_KEY — no free tier, used if neither of the above is set.
#
# (GitHub Copilot isn't an option here — Copilot has no public API for
# server-side completions from a third-party app like this one.)
#
# Never reference any of these with a NEXT_PUBLIC_ prefix and never import
# them into a Client Component — they must only ever be read inside a Route
# Handler / Server Component.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a specific provider instead of auto-selecting by which key
# is set above. One of: gemini | deepseek | anthropic
AI_PROVIDER=

# Optional — Google AdSense. Leave both unset and the ad slot in the sidebar
# simply doesn't render (no script loads, nothing shows). Set once you have
# an approved AdSense account: CLIENT_ID is your publisher ID (ca-pub-...),
# SLOT_SIDEBAR is the ad-unit ID for the sidebar placement (create it in the
# AdSense console). ads.txt is served dynamically from CLIENT_ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
