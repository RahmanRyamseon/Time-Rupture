# Copy to .env (local runs) and fill in. Never commit .env.
# In GitHub Actions these come from repository secrets instead.

# --- Gemini (digest) --------------------------------------------------------
GEMINI_API_KEY=

# --- WhatsApp: Twilio (default; set WHATSAPP_PROVIDER = "twilio" in config.py)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=
# Sandbox: whatsapp:+14155238886. Production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own number, E.164 format, the one that joined the sandbox or receives alerts.
MY_WHATSAPP_NUMBER=+973XXXXXXXX
# Optional. Set to a Twilio Content (template) SID for production sends that
# start a conversation outside the 24-hour customer-service window.
TWILIO_CONTENT_SID=

# --- WhatsApp: Meta Cloud API (alternative; set WHATSAPP_PROVIDER = "meta")
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Optional. Name of an approved utility template with one body variable {{1}}.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=en
