# ---------------------------------------------------------------------------
# Attar Wiki environment. Copy to .env.local for development.
# Variables starting with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_NAME="Attar Wiki"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by the CSV import scripts (npm run import). Never set it
# in the browser or commit it. The web app itself does not need it.
SUPABASE_SERVICE_ROLE_KEY=

# Show the "Continue with Google" button (enable the Google provider in Supabase Auth first)
NEXT_PUBLIC_AUTH_GOOGLE=false

# Anthropic (optional). Enables AI re-ranking in "Find your attar".
# Without it the matcher uses rule-based scoring only.
ANTHROPIC_API_KEY=
